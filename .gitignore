# Build artifacts
/bin/
/dist/
/web/node_modules/

# web/dist is a build output, but we commit a placeholder index.html so the
# go:embed directive in web/embed.go resolves. Ignore everything in web/dist
# EXCEPT the placeholder.
/web/dist/*
!/web/dist/index.html

# Go workspace files (we use a single module, not a workspace)
/go.work
/go.work.sum

# Local environment overrides
.env
.env.local
.env.*.local

# Editor / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Test artifacts
coverage.out
coverage.txt
*.test
*.prof

# Logs
*.log

# tsnet state (do not commit tailnet credentials or state)
/tsnet-state/
